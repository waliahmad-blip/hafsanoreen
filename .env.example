# ═══════════════════════════════════════
# HAFFU STUDIO — Environment Variables
# ═══════════════════════════════════════

# ─── Server ───────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=https://hafsanoreen.com

# ─── Vertex AI (Multi-Model Fleet) ────
# Every model id lives ONLY in your private .env (never in code or git).
# Fill each slot with the model available in your project dashboard.
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=
VERTEX_AI_FAST_MODEL=
VERTEX_AI_VISION_MODEL=
VERTEX_AI_IMAGE_MODEL=
VERTEX_AI_IMAGE_PRO_MODEL=
VERTEX_AI_IMAGEN_MODEL=
VERTEX_AI_VIDEO_MODEL=
VERTEX_AI_MUSIC_MODEL=
VERTEX_AI_TRANSCRIBE_MODEL=
VERTEX_AI_TRANSLATE_MODEL=
VERTEX_AI_EMBEDDING_MODEL=
VERTEX_AI_CREDENTIALS_PATH=./service-account.json

# ─── Firebase / Firestore ─────────────
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── Stripe Payments ──────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PORTRAIT=price_...
STRIPE_PRICE_FAMILY=price_...
STRIPE_PRICE_EVENT=price_...
STRIPE_PRICE_WEDDING=price_...
STRIPE_PRICE_SIGNATURE=price_...

# ─── Google Calendar ──────────────────
GOOGLE_CALENDAR_ID=hafsa@hafsanoreen.com
GOOGLE_CALENDAR_CREDENTIALS_PATH=./calendar-credentials.json

# ─── Email (Resend / SendGrid) ────────
EMAIL_FROM=hello@hafsanoreen.com
EMAIL_API_KEY=re_...

# ─── WhatsApp Business API ────────────
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ACCESS_TOKEN=...

# ─── Security ─────────────────────────
API_KEY=your-secure-api-key-here
CSRF_SECRET=your-csrf-secret
SESSION_SECRET=your-session-secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100